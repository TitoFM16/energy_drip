# Copy to .env.production; keep out of Git and restrict with chmod 600.
# Use three DNS names pointing to the same VPS. Only ports 80/443 are public.
SITE_DOMAIN=clinic.example.com
STAFF_DOMAIN=admin.clinic.example.com
CONSENT_DOMAIN=consent.clinic.example.com
TLS_EMAIL=owner@example.com
# Generate EACH value independently: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD so DATABASE_URL needs no escaping.
POSTGRES_PASSWORD=
SECRET_KEY=
CLINIC_TIMEZONE=America/Bogota
# Optional when exactly one active clinic exists. Set explicitly after bootstrap.
PUBLIC_ORGANIZATION_ID=

# No storage subscription required. /data persists in app_data.
STORAGE_BACKEND=local
# Optional private S3-compatible bucket, pre-created before enabling s3.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=medical-platform
