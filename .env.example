# Host-based development (Docker Compose sets its own container variables).
DATABASE_URL=postgresql+asyncpg://medical:medical@localhost:5432/medical_platform
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
CLINIC_TIMEZONE=America/Bogota
PUBLIC_ORGANIZATION_ID=
PATIENT_WEB_BASE_URL=http://localhost:5174

# Local persistent private consents and public service photos.
STORAGE_BACKEND=local
PRIVATE_STORAGE_PATH=./data/private
PUBLIC_MEDIA_PATH=./data/media
# Optional S3-compatible private consent storage only.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=medical-platform
