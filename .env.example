# Database
DATABASE_URL=postgresql+asyncpg://medical:medical@localhost:5432/medical_platform

# Redis (queue / cache)
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, S3-compatible in production)
S3_ENDPOINT_URL=http://localhost:9000
# Only needed when S3_ENDPOINT_URL isn't reachable from a browser (e.g.
# docker-compose.yml sets S3_ENDPOINT_URL to the internal http://minio:9000
# and this to http://localhost:9000) — leave unset here since both already
# point at the same host-reachable address outside Docker.
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=medical
S3_SECRET_KEY=medical123
S3_BUCKET=medical-platform

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_HOURS=2

# Notifications (fill in real credentials per environment). WhatsApp is the
# only outbound channel this product uses — no SMS provider is integrated.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta App Secret, for verifying delivery-status webhook signatures.
WHATSAPP_APP_SECRET=
# Arbitrary string you also enter in Meta's App Dashboard when registering
# the webhook URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PATIENT_WEB_BASE_URL=http://localhost:5174

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
